<script>
    function CalculateRowAmt(i, callfrm) {
        debugger;

        var AVWGHT = 0, REFAMT = 0, BROKAMT = 0, LOSSAMT = 0, PRATE = 0, PAMT = 0;

        var PCS = retFloat($("#RATE_PCS_" + i).val());
        var WGHT = retFloat($("#RATE_WGHT_" + i).val());
        var SRATE = retFloat($("#RATE_SRATE_NEW_" + i).val());
        var SAMT = retFloat($("#RATE_SAMT_" + i).val());
        var WGHT = retFloat($("#RATE_WGHT_" + i).val());
        var LOSSWGHT = retFloat($("#RATE_LOSSWGHT_" + i).val());

        var PRATE = retFloat($("#RATE_PRATE_NEW_" + i).val());
        var PAMT = retFloat($("#RATE_PAMT_" + i).val());

        if (callfrm == "srate") {
            SAMT = retFloat(WGHT * SRATE).toFixed(2);
            SAMT = retFloat(RoundOff(SAMT, 0)).toFixed(2);
            $("#RATE_SAMT_" + i).val(SAMT);
        }
        if (callfrm == "prate") {
            PAMT = retFloat((WGHT + LOSSWGHT) * PRATE).toFixed(2);
            PAMT = retFloat(RoundOff(PAMT, 0)).toFixed(2);
            $("#RATE_PAMT_" + i).val(PAMT);
        }

        CalculateTotal();
    }
    function CalculateTotal() {
        debugger;
        var T_S_SAMT = 0, T_S_PAMT = 0;

        var GridRow = $("#_Rep_Data_Qry_Updt_GRID > tbody > tr").length;
        for (var i = 0; i <= GridRow - 1; i++) {
            T_S_SAMT += retFloat($("#RATE_SAMT_" + i).val());
            T_S_PAMT += retFloat($("#RATE_PAMT_" + i).val());
        }

        $("#T_SAMT").val(retFloat(T_S_SAMT).toFixed(2));
        $("#T_PAMT").val(retFloat(T_S_PAMT).toFixed(2));
    }
</script>


