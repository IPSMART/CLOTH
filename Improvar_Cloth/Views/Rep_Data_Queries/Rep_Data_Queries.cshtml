<script>
    function Update() {
        debugger;
        var val = ($("#TEXTBOX1").find(":selected").val());
        if (val == "Change Item") {
            if (!emptyFieldCheck("Select/Enter Work No.", "WORKNO")) { return false; }
            if (!emptyFieldCheck("Select/Enter New Style No.", "NEWITCD")) { return false; }
            if ($("#OLDITCD").val() == $("#NEWITCD").val()) {
                msgInfo("Old Item and New Item is same !!");
                message_value = "NEWITCD";
                return false;
            }
        }

        else if (val == "Change Work_No") {
            if (!emptyFieldCheck("Select/Enter From Work No.", "NEWWORKNO")) { return false; }
        }
        else if (val == "Change Less_per") {
            if (!emptyFieldCheck("Select/Enter Party", "SLCD")) { return false; }

        }
        else if (val == "Change Opening Rate") {
            if (!emptyFieldCheck("Select/Enter Document No.", "DOCNO5")) { return false; }
            //if (!emptyFieldCheck("Select/Enter New Rate", "NEWRATE")) { return false; }
            if (retFloat($("#NEWRATE").val()) == 0) {
                msgInfo("Select/Enter New Rate !!");
                message_value = "NEWRATE";
                return false;
            }
        }
        else if (val == "Change Stone Rate") {
            var WORKNORATE = $("#WORKNORATE").val();
            var AUTONORATE = $("#AUTONORATE").val();
            var ITCDRATE = $("#ITCDRATE").val();
            if (WORKNORATE == "" && ITCDRATE == "") {
                msgInfo("Please Select / Enter Item or Workno");
                message_value = 'ITCDRATE';
                return false;
            }
            //if (!emptyFieldCheck("Select/Enter Work No.", "WORKNORATE")) { return false; }
            //if (!emptyFieldCheck("Select/Enter Autono", "AUTONORATE")) { return false; }

            var cnt = 0;
            var GridRow = $("#_Rep_Data_Qry_Updt_GRID > tbody > tr").length;
            for (var i = 0; i <= GridRow - 1; i++) {
                if (document.getElementById("RATE_CHECKED_" + i).checked == true) {
                    cnt++;
                }
            }
            if (cnt == 0) {
                msgInfo("Please Checked Row for Rate Change !!");
                return false;
            }
        }
        else if (val == "Huid Add/Update") {
            if (!emptyFieldCheck("Select/Enter Work No.", "HUID_WORKNO")) { return false; }
        }

        $.ajax({
            type: 'post',
            beforesend: $("#WaitingMode").show(),
            url: "@Url.Action("Save", PageControllerName)",
            data: $('form').serialize(),
            success: function (result) {
                if (result == "1") {
                    $("#WaitingMode").hide();
                    msgSuccess1("Update Successfully");


                } else {
                    msgWarning(result);
                    $("#WaitingMode").hide();
                    return false;
                }

            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                $("#WaitingMode").hide();
                msgError(XMLHttpRequest.responseText);
                $("body span h1").remove(); $("#msgbody_error style").remove();
            }
        });
    }
</script>
<script>
    function ChangeWorkNo_Item() {
        debugger;
        var val = ($("#TEXTBOX1").find(":selected").val());
        if (val == "Change Customer_View") {
            $("#5thdiv").show(); $("#divUpdate").show();
        }
        else if (val == "select") {
            $("#5thdiv").hide(); $("#divUpdate").hide();
        }
    }
</script>
