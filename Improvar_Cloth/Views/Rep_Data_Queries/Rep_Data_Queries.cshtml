<script>
    function GetWorkNoDetails(id, tag) {
        debugger;

        if (id == "") {
            if (tag == "Change Item") {
                ClearAllTextBoxes("WORKNO,OLDITCD,OLDITNM,NEWITCD,NEWITNM");
            }
            else
                if (tag == "FWork_No") {
                    ClearAllTextBoxes("OLDWORKNO,OLDITCD");
                } else {
                    ClearAllTextBoxes("WORKID,ITCD");

                }

        }
        else {
            var code = "";
            if (tag == "Change Item") {
                code = $("#WORKNO").val() + String.fromCharCode(181) + $("#OLDITCD").val() + String.fromCharCode(181) + tag;
            }
            else if (tag == "FWork_No") {
                code = $("#OLDWORKNO").val() + String.fromCharCode(181) + '' + String.fromCharCode(181) + tag;
            }
            else {
                code = $("#WORKID").val() + String.fromCharCode(181) + '' + String.fromCharCode(181) + tag;

            }

            var val = id;
            if (val.indexOf('+') >= 0) {
                val = val.replaceAll("+", "%2B");//encodeURIComponent('+')="%2B"
            }
            $.ajax({
                type: 'POST',
                beforesend: $("#WaitingMode").show(),
                url: "@Url.Action("GetWorkNo", PageControllerName)",
                data: "&val=" + val + "&Code=" + code,
                success: function (result) {
                    var MSG = result.indexOf('#helpDIV');
                    if (MSG >= 0) {
                        if (tag == "Change Item") {
                            ClearAllTextBoxes("WORKNO,OLDITCD,OLDITNM,NEWITCD,NEWITNM");
                            $('#SearchFldValue').val("WORKNO");
                            $('#helpDIV').html(result);
                            $('#ReferanceFieldID').val("WORKNO/OLDITCD/OLDITNM/NEWITCD/NEWITNM");
                            $('#ReferanceColumn').val("0/2/1/2/1");

                        }
                        else if (tag == "FWork_No") {
                            ClearAllTextBoxes("OLDWORKNO,OLDITCD");
                            $('#SearchFldValue').val("OLDWORKNO");
                            $('#helpDIV').html(result);
                            $('#ReferanceFieldID').val("OLDWORKNO/OLDITCD");
                            $('#ReferanceColumn').val("0/2");

                        }
                        else {
                            ClearAllTextBoxes("WORKID,ITCD");
                            $('#SearchFldValue').val("WORKID");
                            $('#helpDIV').html(result);
                            $('#ReferanceFieldID').val("WORKID/ITCD");
                            $('#ReferanceColumn').val("0/2");

                        }

                        $('#helpDIV_Header').html("Work No. Details");
                    }
                    else {
                        var MSG = result.indexOf(String.fromCharCode(181));
                        if (MSG >= 0) {
                            if (tag == "Change Item") {
                                $("#WORKNO").val(returncolvalue(result, "WORKNO"));
                                $("#OLDITCD").val(returncolvalue(result, "ITCD"));
                                $("#OLDITNM").val(returncolvalue(result, "ITNM"));
                                $("#NEWITCD").val(returncolvalue(result, "ITCD"));
                                $("#NEWITNM").val(returncolvalue(result, "ITNM"));
                            }
                            else if (tag == "FWork_No") {
                                $("#OLDWORKNO").val(returncolvalue(result, "WORKNO"));
                                $("#OLDITCD").val(returncolvalue(result, "ITCD"));

                            }
                            else {
                                $("#WORKID").val(returncolvalue(result, "WORKNO"));
                                $("#ITCD").val(returncolvalue(result, "ITCD"));
                            }
                        }
                        else {
                            $('#helpDIV').html("");
                            msgInfo("" + result + " !");
                            if (tag == "Change Item") {
                                ClearAllTextBoxes("WORKNO,OLDITCD,OLDITNM,NEWITCD,NEWITNM");
                                message_value = "WORKNO";
                            }
                            else if (tag == "FWork_No") {
                                ClearAllTextBoxes("OLDWORKNO,OLDITCD");
                                message_value = "OLDWORKNO";
                            }
                            else {
                                ClearAllTextBoxes("WORKID,ITCD");
                                message_value = "WORKID";

                            }

                        }
                    }
                    $("#WaitingMode").hide();
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    $("#WaitingMode").hide();
                    msgError(XMLHttpRequest.responseText);
                    $("body span h1").remove(); $("#msgbody_error style").remove();
                }
            });
        }

    }
</script>
