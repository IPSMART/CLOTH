<script>
    function AddRow(ID, TABLE) {
        debugger;
        var TAG = ""; var COUNT = document.getElementById(ID).value; if (COUNT != "") { COUNT = parseInt(COUNT); } else { COUNT = parseInt(0); } if (COUNT > 0) { TAG = "Y"; }
        $.ajax({
            type: 'POST',
            url: "@Url.Action("AddRow", PageControllerName)",
            beforesend: $("#WaitingMode").show(),
            data: $('form').serialize() + "&COUNT=" + COUNT + "&TAG=" + TAG + "&TABLE=" + TABLE,
            success: function (result) {
                $("#WaitingMode").hide();
                if (TABLE == "_Rep_Huid_Update_Huid") {
                    $("#partialdiv").animate({ marginTop: '-10px' }, 50);
                    $("#partialdiv").html(result);
                }
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                $("#WaitingMode").hide();
                msgError(XMLHttpRequest.responseText);
                $("body span h1").remove(); $("#msgbody_error style").remove();
            }
        });
    }
    function DeleteRow(TABLE) {
        $.ajax({
            type: 'POST',
            url: "@Url.Action("DeleteRow", PageControllerName)",
            data: $('form').serialize() + "&TABLE=" + TABLE,
            success: function (result) {
                if (TABLE == "_Rep_Huid_Update_Huid") {
                    $("#partialdiv").animate({ marginTop: '0px' }, 50);
                    $("#partialdiv").html(result);
                }
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                $("#WaitingMode").hide();
                msgError(XMLHttpRequest.responseText);
                $("body span h1").remove(); $("#msgbody_error style").remove();
            }
        });
    }
</script>
<script>
    function GetSalebill() {

        //if (!emptyFieldCheck("Please Select / Enter From Date", "FROMDT")) { return false; }
        //if (!emptyFieldCheck("Please Select / Enter To Date", "TODT")) { return false; }
        var fdt = $("#FROMDT").val();
        var tdt = $("#TODT").val();
        $.ajax({
            type: 'POST',
            url: "@Url.Action("GetSalebill", PageControllerName)",
            beforesend: $("#WaitingMode").show(),
            data: $('form').serialize() + "&FROMDT=" + fdt + "&TODT=" + tdt,
            success: function (result) {
                var MSG = result.indexOf('_Rep_Misc_Qry_Updt_IV_GRID');
                if (MSG >= 0) {
                    $("#partialdivIV").html(result);
                    $("#WaitingMode").hide();
                }
                else {
                    msgInfo(result);
                    message_value = 'FROMDT';
                }
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                $("#WaitingMode").hide();
                msgError(XMLHttpRequest.responseText);
                $("body span h1").remove(); $("#msgbody_error style").remove();
            }
        });
    }
    function ExcelData(id) {
        debugger;
        $("#BtnName").val(id);
        jQuery("form").append('<input type="hidden" id="BtnName" name="BtnNm" value=' + id + ' />');
        jQuery("form").attr("target", "_blank");
        jQuery("form").submit();
    }
</script>

